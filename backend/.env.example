# Configuração da base de dados Oracle
# Copia este ficheiro para .env e preenche com os teus valores

DB_HOST=172.20.10.X          # IP da VM CentOS onde corre o Oracle XE
DB_PORT=1521
DB_SERVICE=XE

# Utilizador comum (após executar os scripts SQL na VM)
DB_USER=JnrLite
DB_PASSWORD=1234

# Se usares o utilizador SYS, descomenta as duas linhas abaixo
# DB_USER=sys
# DB_PASSWORD=<password_do_sys>
# DB_PRIVILEGE=SYSDBA

# Caminho para o Oracle Instant Client descomprimido no teu Windows
# Download: https://www.oracle.com/database/technologies/instant-client/downloads.html
INSTANT_CLIENT_PATH=C:/instantclient_21_20

PORT=3000
NLS_LANG=AMERICAN_AMERICA.AL32UTF8
NODE_NAME=BibliotecaNacionalDB   # Identificador do nó — usado na auditoria cross-node
