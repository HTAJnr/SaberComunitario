# ══════════════════════════════════════════════════════════════════
# Saber Comunitário — configuração de ligações Oracle (4 nós)
# Copia este ficheiro para .env e preenche com os IPs e credenciais
# ══════════════════════════════════════════════════════════════════

# ── BibliotecaNacionalDB (VM Hélder) ──────────────────────────────
NACIONAL_HOST=172.20.10.X
NACIONAL_PORT=1521
NACIONAL_SERVICE=XE
NACIONAL_USER=app_NACIONALDB
NACIONAL_PASSWORD=<password>

# ── MateriaisDB (VM Yasin) ────────────────────────────────────────
MATERIAIS_HOST=172.20.10.X
MATERIAIS_PORT=1521
MATERIAIS_SERVICE=XE
MATERIAIS_USER=app_materiaisdb
MATERIAIS_PASSWORD=<password>

# ── EmpréstimosDB (VM Yannis) ─────────────────────────────────────
EMPRESTIMOS_HOST=172.20.10.X
EMPRESTIMOS_PORT=1521
EMPRESTIMOS_SERVICE=XE
EMPRESTIMOS_USER=app_emprestimosdb
EMPRESTIMOS_PASSWORD=<password>

# ── EventosBibliotecasDB (VM Gerson) ─────────────────────────────
EVENTOS_HOST=172.20.10.X
EVENTOS_PORT=1521
EVENTOS_SERVICE=XE
EVENTOS_USER=app_eventosdb
EVENTOS_PASSWORD=<password>

# ── Aplicação ─────────────────────────────────────────────────────
INSTANT_CLIENT_PATH=C:/instantclient_21_20
PORT=3000
NLS_LANG=AMERICAN_AMERICA.AL32UTF8
NODE_NAME=BibliotecaNacionalDB
